# ============================================================
# Garden .env.example — 所有环境变量文档
# 复制此文件为 .env.local 并填入实际值
# ============================================================

# --- 站点访问控制 ---
# 访问密码（必填）。所有页面和 API 都需要此密码登录后才能访问。
# 登录后签发 HMAC-SHA256 签名的 stateless token（30 天有效期）。
SITE_PASSWORD=your-password-here

# --- Supabase（Auth + 旧版 DB/Storage fallback）---
# 阶段 5 决策：保留 Supabase Auth（选项 A），所以以下变量仍需保留。
#
# Supabase 项目 URL（客户端可见，供 Auth + Storage URL 兜底用）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
#
# Supabase anon key（客户端可见，供 Auth SDK 用）
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
#
# Supabase service key（仅服务端，绕过 RLS 的管理员密钥）
# ⚠️ 迁移完成后可移除：当 VPS_DB_URL + VPS_STORAGE_URL 均已配置且
#    Supabase fallback 不再需要时，删除此变量和代码中的 supabaseFetch 路径。
#    当前保留是为了 VPS 不可用时的 fallback。
SUPABASE_SERVICE_KEY=your-service-key
#
# 单用户模式的本地 user_id（用于 app-layer RLS 过滤和资源归属）
SUPABASE_LOCAL_USER_ID=your-local-user-uuid

# --- VPS 存储（Nginx WebDAV）---
# VPS 存储服务端 URL（仅服务端，用于 upload/delete 操作）
# 示例：https://storage.minitu.online/storage
VPS_STORAGE_URL=https://your-vps-domain/storage
#
# VPS 存储认证 key（仅服务端，x-storage-key header）
VPS_STORAGE_KEY=your-vps-storage-key
#
# VPS 存储公共 URL（客户端可见，供 resolveStorageUrl 运行时解析 storagePath → URL）
# 通常与 VPS_STORAGE_URL 相同（如果存储路径是公共可读的）
NEXT_PUBLIC_VPS_STORAGE_URL=https://your-vps-domain/storage

# --- VPS 数据库（PostgREST）---
# VPS PostgREST 基础 URL（仅服务端）
# 示例：https://your-vps-domain/api/db
VPS_DB_URL=https://your-vps-domain/api/db
#
# VPS PostgREST 认证 key（仅服务端，x-storage-key header）
VPS_DB_KEY=your-vps-db-key

# ============================================================
# 以下变量由 Vercel 自动注入，不需要手动设置（仅本地开发时可能需要）：
# VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_GIT_*, VERCEL_OIDC_TOKEN,
# VERCEL_TARGET_ENV, TURBO_*, NX_DAEMON
# ============================================================
